        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Was vermeidest du, und was ist ein kleiner Schritt darauf zu?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What are you avoiding, and what's one small step toward it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Qué estás evitando y cuál es un pequeño paso hacia eso?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qu'évitez-vous, et quel petit pas pourriez-vous faire vers cela ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Che cosa stai evitando, e qual è un piccolo passo verso quella cosa?"
