<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSCameraUsageDescription</key>
	<string>Mirror uses the camera so you can capture photos, videos, and scanned documents in your notes.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Mirror saves photos from your journal entries to your photo library.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Mirror uses the microphone so you can attach voice notes to journal entries.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Mirror uses on-device speech recognition to transcribe voice notes without sending audio off your device.</string>
<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.lokesh.mirror.weeklyDigest</string>
		<string>com.lokesh.mirror.nightlyInsights</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mirror</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
