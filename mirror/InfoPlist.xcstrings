    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes verwendet die Spracherkennung auf dem Gerät, um deine Spracheinträge zu transkribieren, ohne Audio von deinem Gerät zu senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes uses on-device speech recognition to transcribe your voice entries without sending audio off your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes usa reconocimiento de voz en el dispositivo para transcribir tus entradas de voz sin enviar audio fuera de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes utilise la reconnaissance vocale sur l'appareil pour transcrire vos entrées vocales sans envoyer l'audio hors de votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes usa il riconoscimento vocale sul dispositivo per trascrivere le tue voci vocali senza inviare audio fuori dal dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotesは、端末上の音声認識を使用して、音声を端末外に送信せずに音声エントリーを文字起こしします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes는 기기 내 음성 인식을 사용해 오디오를 기기 밖으로 보내지 않고 음성 항목을 전사합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MirrorNotes usa reconhecimento de fala no dispositivo para transcrever suas entradas de voz sem enviar áudio para fora do seu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes использует распознавание речи на устройстве, чтобы расшифровывать ваши голосовые записи, не отправляя аудио с устройства."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes 使用设备端语音识别转录你的语音条目，不会将音频发送出你的设备。"
          }
        }
      }
    }
