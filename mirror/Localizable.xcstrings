    "Permanently deletes all entries and insights from this device and iCloud. Cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht dauerhaft alle Einträge und Erkenntnisse von diesem Gerät und aus iCloud. Kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently deletes all entries and insights from this device and iCloud. Cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina permanentemente todas las entradas e insights de este dispositivo y de iCloud. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement toutes les entrées et aperçus de cet appareil et d'iCloud. Action irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente tutte le voci e gli approfondimenti da questo dispositivo e da iCloud. Non può essere annullato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末とiCloudからすべてのエントリーとインサイトを完全に削除します。元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기와 iCloud에서 모든 항목과 인사이트를 영구적으로 삭제합니다. 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exclui permanentemente todas as entradas e percepções deste dispositivo e do iCloud. Não pode ser desfeito."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навсегда удаляет все записи и инсайты с этого устройства и из iCloud. Действие необратимо."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将永久删除此设备和 iCloud 中的所有条目和洞察，且无法撤销。"
          }
        }
      }
    },
