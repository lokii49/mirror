    "This entry still exists, but this device does not have the encryption key needed to read its text." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Eintrag existiert noch, aber diesem Gerät fehlt der Verschlüsselungsschlüssel, um den Text zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This entry still exists, but this device does not have the encryption key needed to read its text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta entrada aún existe, pero este dispositivo no tiene la clave de cifrado necesaria para leer su texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette entrée existe toujours, mais cet appareil n'a pas la clé de chiffrement nécessaire pour lire son texte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa voce esiste ancora, ma questo dispositivo non ha la chiave di crittografia necessaria per leggerne il testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエントリーは存在しますが、この端末にはテキストを読むために必要な暗号化キーがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목은 여전히 존재하지만, 이 기기에는 텍스트를 읽는 데 필요한 암호화 키가 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta entrada ainda existe, mas este dispositivo não tem a chave de criptografia necessária para ler seu texto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта запись всё ещё существует, но на этом устройстве нет ключа шифрования, необходимого для чтения текста."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此条目仍然存在，但此设备没有读取其文本所需的加密密钥。"
          }
        }
      }
    },
    "This image could not be attached. Try a different image or export it as JPEG first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Bild konnte nicht angehängt werden. Versuche es mit einem anderen Bild oder exportiere es zuerst als JPEG."
          }
        },
