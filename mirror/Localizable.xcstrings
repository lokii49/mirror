    "Free users keep full access to all their entries forever. Cancelling a subscription never deletes your journal." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlose Nutzer behalten für immer vollen Zugriff auf alle ihre Einträge. Das Kündigen eines Abos löscht dein Journal niemals."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free users keep full access to all their entries forever. Cancelling a subscription never deletes your journal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los usuarios gratuitos conservan acceso completo a todas sus entradas para siempre. Cancelar una suscripción nunca elimina tu diario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les utilisateurs gratuits gardent un accès complet à toutes leurs entrées, pour toujours. Résilier un abonnement ne supprime jamais votre journal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli utenti gratuiti mantengono l'accesso completo a tutte le loro voci per sempre. Annullare un abbonamento non elimina mai il tuo diario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料ユーザーもすべてのエントリーに永久にフルアクセスできます。サブスクリプションを解約しても日記が削除されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 사용자도 자신의 모든 항목에 영구히 완전히 접근할 수 있습니다. 구독을 취소해도 일기는 절대 삭제되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuários gratuitos mantêm acesso total a todas as suas entradas para sempre. Cancelar uma assinatura nunca exclui seu diário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бесплатные пользователи навсегда сохраняют полный доступ ко всем своим записям. Отмена подписки никогда не удаляет ваш дневник."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费用户可永久完整访问自己的全部条目。取消订阅绝不会删除你的日记。"
          }
        }
      }
    },
