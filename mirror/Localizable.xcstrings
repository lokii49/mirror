    "Spanish, Japanese, Chinese, German, French, Portuguese, Korean, Italian, and Russian — alongside English. Switch your device language and mirror follows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spanisch, Japanisch, Chinesisch, Deutsch, Französisch, Portugiesisch, Koreanisch, Italienisch und Russisch — neben Englisch. Wechsle die Gerätesprache, und mirror folgt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spanish, Japanese, Chinese, German, French, Portuguese, Korean, Italian, and Russian — alongside English. Switch your device language and mirror follows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Español, japonés, chino, alemán, francés, portugués, coreano, italiano y ruso, además de inglés. Cambia el idioma de tu dispositivo y mirror te sigue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espagnol, japonais, chinois, allemand, français, portugais, coréen, italien et russe — en plus de l'anglais. Changez la langue de votre appareil et mirror suit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spagnolo, giapponese, cinese, tedesco, francese, portoghese, coreano, italiano e russo, oltre all'inglese. Cambia la lingua del dispositivo e mirror si adegua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英語に加えて、スペイン語、日本語、中国語、ドイツ語、フランス語、ポルトガル語、韓国語、イタリア語、ロシア語に対応。端末の言語を切り替えると、mirrorもそれに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영어와 함께 스페인어, 일본어, 중국어, 독일어, 프랑스어, 포르투갈어, 한국어, 이탈리아어, 러시아어를 지원합니다. 기기 언어를 바꾸면 mirror도 따라갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espanhol, japonês, chinês, alemão, francês, português, coreano, italiano e russo — além do inglês. Troque o idioma do seu dispositivo e o mirror acompanha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Испанский, японский, китайский, немецкий, французский, португальский, корейский, итальянский и русский — помимо английского. Смените язык устройства, и mirror последует за ним."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除英语外，还支持西班牙语、日语、中文、德语、法语、葡萄牙语、韩语、意大利语和俄语。切换设备语言，mirror 会自动跟随。"
          }
        }
      }
    },
