    "mirror uses an on-device language model to generate insights. Your journal text never touches our servers. Ever." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mirror verwendet ein Sprachmodell auf dem Gerät, um Erkenntnisse zu erzeugen. Der Text deines Journals berührt niemals unsere Server. Niemals."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mirror uses an on-device language model to generate insights. Your journal text never touches our servers. Ever."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "mirror usa un modelo de lenguaje en el dispositivo para generar insights. El texto de tu diario nunca llega a nuestros servidores. Jamás."
