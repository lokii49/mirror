    "MIC ACCESS REQUIRED.\nSETTINGS → PRIVACY → MICROPHONE." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIKROFONZUGRIFF ERFORDERLICH.\nEINSTELLUNGEN → DATENSCHUTZ → MIKROFON."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MIC ACCESS REQUIRED.\nSETTINGS → PRIVACY → MICROPHONE."
