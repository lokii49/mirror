          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes notó algo en tus primeras entradas. Abre para verlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes a remarqué quelque chose dans vos premières entrées. Ouvrez pour le voir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes ha notato qualcosa nelle tue prime voci. Apri per vedere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotesが最初のエントリーに何かを見つけました。開いて確認しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes가 첫 항목들에서 무언가를 발견했습니다. 열어서 확인해 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O MirrorNotes percebeu algo nas suas primeiras entradas. Abra para ver."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes заметил кое-что в ваших первых записях. Откройте, чтобы посмотреть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MirrorNotes 在你的最初几篇记录中发现了一些内容。打开查看。"
