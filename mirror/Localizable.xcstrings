    "You've been carrying a lot lately. Take a gentle moment for yourself." : {
      "comment" : "Push notification body for a mood alert",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast in letzter Zeit viel mit dir getragen. Nimm dir einen sanften Moment für dich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've been carrying a lot lately. Take a gentle moment for yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has estado cargando mucho últimamente. Tómate un momento amable para ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous portez beaucoup ces derniers temps. Accordez-vous un moment de douceur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimamente stai portando tanto dentro di te. Prenditi un momento gentile per te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近、たくさん抱えてきましたね。自分のためにやさしい時間を取りましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요즘 많은 것을 짊어지고 있었네요. 자신을 위해 부드러운 시간을 가져 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem carregado muita coisa ultimamente. Tire um momento gentil para si."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В последнее время вам многое пришлось нести. Подарите себе мягкий момент заботы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你最近承受了很多。给自己留一个温柔的片刻。"
          }
        }
      }
    },
