    "Quick-capture widget for your home screen and lock screen. See today's reflection or write a new entry without unlocking the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnellerfassungs-Widget für Homescreen und Sperrbildschirm. Sieh die heutige Reflexion oder schreibe einen neuen Eintrag, ohne die App zu entsperren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quick-capture widget for your home screen and lock screen. See today's reflection or write a new entry without unlocking the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget de captura rápida para tu pantalla de inicio y de bloqueo. Ve la reflexión de hoy o escribe una nueva entrada sin desbloquear la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget de capture rapide pour votre écran d'accueil et de verrouillage. Consultez la réflexion du jour ou rédigez une nouvelle entrée sans déverrouiller l'application."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget di acquisizione rapida per la schermata Home e di blocco. Vedi la riflessione di oggi o scrivi una nuova voce senza sbloccare l'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面とロック画面用のクイックキャプチャウィジェット。アプリのロックを解除せずに、今日のリフレクションを見たり新しいエントリーを書いたりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 화면과 잠금 화면용 빠른 캡처 위젯. 앱 잠금을 해제하지 않고도 오늘의 리플렉션을 보거나 새 항목을 작성할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget de captura rápida para a tela inicial e de bloqueio. Veja a reflexão de hoje ou escreva uma nova entrada sem desbloquear o app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виджет быстрого доступа для главного экрана и экрана блокировки. Смотрите сегодняшнюю рефлексию или пишите новую запись, не разблокируя приложение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
