    "Mirror builds this map from names and topics\nthat repeat across your entries." : {
      "comment" : "A description of how the Brain View is generated.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror erstellt diese Karte aus Namen und Themen,\ndie sich in deinen Einträgen wiederholen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror builds this map from names and topics\nthat repeat across your entries."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror crea este mapa a partir de nombres y temas\nque se repiten en tus entradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror crée cette carte à partir des noms et sujets\nqui reviennent dans vos entrées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror crea questa mappa da nomi e argomenti\nche si ripetono nelle tue voci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirrorは、あなたのエントリーに繰り返し登場する\n人名やトピックからこのマップを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror는 당신의 항목에 반복해서 등장하는\n이름과 주제로 이 지도를 만듭니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mirror cria este mapa a partir de nomes e temas\nque se repetem nas suas entradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror строит эту карту на основе имён и тем,\nповторяющихся в ваших записях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror 会根据你条目中反复出现的\n人名和主题来构建这张地图。"
          }
        }
      }
    },
    "Mirror couldn't decrypt some entries just now.\nReopen Brain View in a moment." : {
      "comment" : "A description of a message that appears when entries can't be decrypted.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror konnte gerade einige Einträge nicht entschlüsseln.\nÖffne die Denkkarte gleich noch einmal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror couldn't decrypt some entries just now.\nReopen Brain View in a moment."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror no pudo descifrar algunas entradas.\nVuelve a abrir el mapa mental en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror n'a pas pu déchiffrer certaines entrées.\nRouvrez la carte mentale dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror non è riuscito a decifrare alcune voci.\nRiapri la mappa mentale tra poco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のエントリーを復号できませんでした。\nしばらくしてからマインドマップを開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 항목을 방금 해독하지 못했습니다.\n잠시 후 마인드맵을 다시 열어보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Mirror não conseguiu descriptografar algumas entradas agora.\nReabra o mapa mental em instantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror не смог расшифровать некоторые записи.\nОткройте карту мыслей ещё раз через минуту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirror 刚才无法解密部分条目。\n请稍后重新打开思维导图。"
          }
        }
      }
    },
    "Mirror couldn't finish that reflection. Try again." : {
