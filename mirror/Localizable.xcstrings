    "Ask mirror anything about your writing. Get grounded answers from your own journal, not generic advice. Core includes 15 questions per month." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag mirror alles über deine Texte. Erhalte fundierte Antworten aus deinem eigenen Journal, keine allgemeinen Ratschläge. Core enthält 15 Fragen pro Monat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask mirror anything about your writing. Get grounded answers from your own journal, not generic advice. Core includes 15 questions per month."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregúntale a mirror lo que sea sobre tus escritos. Obtén respuestas fundamentadas de tu propio diario, no consejos genéricos. Core incluye 15 preguntas al mes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à mirror tout sur vos écrits. Obtenez des réponses fondées sur votre propre journal, pas des conseils génériques. Core inclut 15 questions par mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi a mirror qualsiasi cosa sui tuoi scritti. Ottieni risposte fondate sul tuo diario, non consigli generici. Core include 15 domande al mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの文章について何でもmirrorに質問できます。一般的なアドバイスではなく、あなた自身の日記に基づいた確かな答えが得られます。Coreには月15回の質問が含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "당신의 글에 대해 무엇이든 mirror에게 물어보세요. 일반적인 조언이 아닌, 당신 자신의 일기에 근거한 답변을 얻을 수 있습니다. Core에는 월 15회 질문이 포함됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte ao mirror qualquer coisa sobre sua escrita. Obtenha respostas fundamentadas no seu próprio diário, não conselhos genéricos. O Core inclui 15 perguntas por mês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрашивайте mirror о чём угодно из ваших записей. Получайте обоснованные ответы из вашего собственного дневника, а не общие советы. Core включает 15 вопросов в месяц."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向 mirror 询问关于你写作的任何事。获得来自你自己日记的可靠答案，而非泛泛的建议。Core 包含每月 15 次提问。"
          }
        }
      }
    },
