    "Suggested: **Evening** (%@) — best for capturing the full day before it fades." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfohlen: **Abend** (%@) — am besten, um den ganzen Tag festzuhalten, bevor er verblasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggested: **Evening** (%@) — best for capturing the full day before it fades."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugerido: **Noche** (%@) — ideal para capturar el día completo antes de que se desvanezca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggéré : **Soir** (%@) — idéal pour capturer toute la journée avant qu'elle ne s'estompe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consigliato: **Sera** (%@) — ideale per catturare l'intera giornata prima che svanisca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おすすめ：**夜**（%@）― 一日の記憶が薄れる前に全体を書き留めるのに最適です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추천: **저녁** (%@) — 하루가 희미해지기 전에 온전히 기록하기 좋아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugerido: **Noite** (%@) — ideal para registrar o dia inteiro antes que ele se apague da memória."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рекомендовано: **Вечер** (%@) — отлично подходит, чтобы запечатлеть весь день, пока он не забылся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推荐：**晚上**（%@）—— 最适合在记忆消退前记录完整的一天。"
          }
        }
      }
    },
