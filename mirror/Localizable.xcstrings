            "state" : "translated",
            "value" : "Con una frase basta. Mirror aprende de todo lo que escribes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une phrase suffit. Mirror apprend de tout ce que vous écrivez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta anche una sola frase. Mirror impara da tutto ciò che scrivi."
