    "Same journal, same on-device AI. Switch anytime in Settings." : {
      "comment" : "A description of the onboarding flow.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dasselbe Journal, dieselbe KI auf dem Gerät. Jederzeit in den Einstellungen wechselbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same journal, same on-device AI. Switch anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mismo diario, la misma IA en el dispositivo. Cambia cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même journal, même IA embarquée. Changez à tout moment dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stesso diario, stessa IA sul dispositivo. Cambia quando vuoi nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ日記、同じオンデバイスAI。設定からいつでも切り替えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 일기, 같은 온디바이스 AI. 설정에서 언제든지 전환할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mesmo diário, a mesma IA no dispositivo. Troque quando quiser em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тот же дневник, тот же ИИ на устройстве. Переключайтесь в любой момент в настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同一本日记，同一个设备端 AI。可随时在设置中切换。"
          }
        }
      }
    },
